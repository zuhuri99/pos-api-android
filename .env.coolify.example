# Isi pada Environment Variables Coolify, bukan di repository production.
# URL internal PostgreSQL dari resource database Coolify juga dapat memakai
# awalan postgresql://; aplikasi akan menormalkannya ke driver psycopg.
DATABASE_URL=postgresql://USER:PASSWORD@HOST_INTERNAL:5432/NAMA_DATABASE
APP_SECRET=GANTI_DENGAN_RANDOM_MINIMAL_64_KARAKTER
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_YANG_KUAT
ADMIN_TOKEN_TTL_DAYS=3650
USER_USERNAME=kasir
USER_PASSWORD=GANTI_DENGAN_PASSWORD_KASIR_YANG_KUAT
USER_TOKEN_TTL_DAYS=3650
USER_AUTHORIZATION_PIN=GANTI_DENGAN_PIN_MINIMAL_6_DIGIT
RESEND_API_KEY=re_GANTI_DENGAN_API_KEY_RESEND
RESEND_FROM_EMAIL="ASAS POS <notifikasi@DOMAIN_TERVERIFIKASI>"
TRANSACTION_NOTIFICATION_EMAILS=EMAIL_PENERIMA_NOTIFIKASI
CORS_ORIGINS=https://pos2.asas.id,https://pos.local
ALLOWED_HOSTS=pos2.asas.id,localhost,127.0.0.1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=3
API_MAX_CONCURRENCY=50
API_THREAD_LIMIT=10
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=512m
