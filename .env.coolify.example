# Isi pada Environment Variables Coolify, bukan di repository production.
# URL internal PostgreSQL dari resource database Coolify juga dapat memakai
# awalan postgresql://; aplikasi akan menormalkannya ke driver psycopg.
DATABASE_URL=postgresql://USER:PASSWORD@HOST_INTERNAL:5432/NAMA_DATABASE
APP_SECRET=GANTI_DENGAN_RANDOM_MINIMAL_64_KARAKTER
BOOTSTRAP_USERNAME=admin
BOOTSTRAP_PASSWORD=GANTI_DENGAN_PASSWORD_ADMIN_YANG_KUAT
TOKEN_TTL_DAYS=30
CORS_ORIGINS=https://pos2.asas.id,https://pos.local
ALLOWED_HOSTS=pos2.asas.id,localhost,127.0.0.1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=3
API_MAX_CONCURRENCY=50
API_THREAD_LIMIT=10
API_CPU_LIMIT=1.0
API_MEMORY_LIMIT=512m
