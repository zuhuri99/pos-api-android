{
	"appId": "id.pos.mobile",
	"appName": "ASAS POS",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"hostname": "pos.local"
	},
	"android": {
		"allowMixedContent": false
	},
	"plugins": {
		"CapacitorHttp": {
			"enabled": true
		},
		"CapacitorSQLite": {
			"androidIsEncryption": true,
			"androidBiometric": {
				"biometricAuth": false
			}
		}
	}
}
